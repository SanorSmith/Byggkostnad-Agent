ANTHROPIC_MODEL=
SCB_BASE_URL=https://api.scb.se/OV0104/v1/doris/sv/ssd/START/PR/PR0502/PR0502A
# Comma-separated origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000,https://byggkostnad-agent.vercel.app
